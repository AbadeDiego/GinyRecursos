{
  "name": "gestao-subvencao",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env scripts/check-env.mjs && next start --hostname 0.0.0.0",
    "test": "node --test tests/backend.test.mjs",
    "lint": "eslint app lib server tests",
    "typecheck": "tsc --noEmit",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "user": "node --env-file-if-exists=.env scripts/user.mjs",
    "test:production": "node --test tests/production.test.mjs",
    "test:all": "npm test && npm run typecheck && npm run build && npm run test:production"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Gest\u00e3o de Subven\u00e7\u00e3o"
}
